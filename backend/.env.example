# Copy this file to .env and fill in your key.
# Get one at https://platform.claude.com/ (API keys section).
# No YouTube API key is required — video listing uses yt-dlp.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when `monitoring` is enabled in config.yaml (the hourly digest
# email). Get one at https://resend.com (API Keys section).
RESEND_API_KEY=re_...
