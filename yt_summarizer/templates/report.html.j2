<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ channel }} — Video Summaries</title>
<style>
  :root {
    --background: hsl(0 0% 100%);
    --foreground: hsl(240 10% 3.9%);
    --card: hsl(0 0% 100%);
    --muted: hsl(240 4.8% 95.9%);
    --muted-foreground: hsl(240 3.8% 46.1%);
    --border: hsl(240 5.9% 90%);
    --accent: hsl(221 83% 53%);
    --radius: 0.75rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --background: hsl(240 10% 3.9%);
      --foreground: hsl(0 0% 98%);
      --card: hsl(240 6% 7%);
      --muted: hsl(240 3.7% 15.9%);
      --muted-foreground: hsl(240 5% 64.9%);
      --border: hsl(240 3.7% 15.9%);
      --accent: hsl(217 91% 65%);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif;
    background: var(--background);
    color: var(--foreground);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  .container { padding: 3rem 1.5rem 5rem; }

  header h1 {
    margin: 0 0 0.35rem;
    font-size: 1.9rem;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .meta {
    color: var(--muted-foreground);
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin: 0;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    margin-top: 1.75rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }
  .card > h2 { margin: 0 0 0.4rem; font-size: 1.25rem; letter-spacing: -0.02em; line-height: 1.35; }
  .card > h2 a { color: inherit; text-decoration: none; }
  .card > h2 a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .watch { color: var(--accent); text-decoration: none; }
  .watch:hover { text-decoration: underline; text-underline-offset: 3px; }

  .prompt-name {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
  }

  .response { font-size: 0.95rem; }
  .response > :first-child { margin-top: 0.5rem; }
  .response > :last-child { margin-bottom: 0; }
  .response h1, .response h2, .response h3, .response h4 {
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin: 1.4rem 0 0.5rem;
  }
  .response h1 { font-size: 1.15rem; }
  .response h2 { font-size: 1.08rem; }
  .response h3 { font-size: 1rem; }
  .response h4 { font-size: 0.95rem; }
  .response ul, .response ol { padding-left: 1.4rem; }
  .response li { margin: 0.25rem 0; }
  .response blockquote {
    margin: 1rem 0;
    padding: 0.25rem 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted-foreground);
  }
  .response code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86em;
    background: var(--muted);
    border-radius: 0.35rem;
    padding: 0.15em 0.4em;
  }
  .response pre {
    background: var(--muted);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
  }
  .response pre code { background: none; padding: 0; }
  .response table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9em;
  }
  .response th, .response td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.7rem;
    text-align: left;
  }
  .response th { background: var(--muted); }
  .response img { max-width: 100%; }
  .response a { color: var(--accent); }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    background: var(--muted);
    border-radius: 9999px;
    padding: 0.12rem 0.7rem;
    font-size: 0.74rem;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .empty {
    margin-top: 3rem;
    text-align: center;
    color: var(--muted-foreground);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 3rem 1rem;
  }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>Video Summaries</h1>
    <p class="meta">
      <span>{{ channel }}</span>
      <span>&middot;</span>
      <span>{{ items | length }} video{{ "s" if items | length != 1 }}</span>
      <span>&middot;</span>
      <span>total cost {{ total_cost }}</span>
      <span>&middot;</span>
      <span>generated {{ generated_at }}</span>
    </p>
  </header>

  {% for item in items %}
  <article class="card">
    <h2><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a></h2>
    <p class="meta">
      <span>{{ item.published }}</span>
      <span>&middot;</span>
      <a class="watch" href="{{ item.url }}" target="_blank" rel="noopener">Watch on YouTube&nbsp;&#8599;</a>
    </p>
    <h3 class="prompt-name">{{ item.prompt_name }}</h3>
    <div class="response">{{ item.response_html | safe }}</div>
    <div class="stats">
      <span class="badge">{{ item.model }}</span>
      <span class="badge">{{ "{:,}".format(item.tokens_input) }} in / {{ "{:,}".format(item.tokens_output) }} out</span>
      <span class="badge">{{ item.cost }}</span>
      <span class="badge">processed {{ item.processed }}</span>
    </div>
  </article>
  {% else %}
  <div class="empty">No videos processed yet. Run the summarizer first.</div>
  {% endfor %}
</div>
</body>
</html>
